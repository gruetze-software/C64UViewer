<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="C64UViewer.Views.HelpWindow"
        Title="C64U Slim-Viewer – Stream Setup" Width="560" Height="640"
        MinWidth="360" MinHeight="360" Icon="/Assets/icon.ico"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16" Margin="24">
        <TextBlock Text="Set up C64U streaming" FontSize="24" FontWeight="SemiBold"/>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="0,0,12,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="1. Prepare the viewer" FontWeight="SemiBold"/>
                    <TextBlock Text="Connect the C64U by Ethernet and put both devices on the same local network. Keep the viewer open. Tick Audio in the viewer if you want sound."
                               TextWrapping="Wrap"/>
                    <TextBlock Text="On the C64U, open WiFi Network Setup and set Wi-Fi to Disabled. In Wired Network Setup, check that the C64U has an IPv4 address."
                               TextWrapping="Wrap"/>
                    <Border Background="#2D2D2D" CornerRadius="5" Padding="12">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="6">
                            <TextBlock Text="Video (UDP)"/>
                            <SelectableTextBlock Grid.Column="1" x:Name="VideoDestination"
                                                 FontFamily="monospace" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Text="Audio (UDP)"/>
                            <SelectableTextBlock Grid.Row="1" Grid.Column="1" x:Name="AudioDestination"
                                                 FontFamily="monospace" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Use the viewer computer’s LAN address. If the address shown belongs to a VPN or the wrong adapter, substitute the LAN address on the C64U’s network."
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="2. Start VIC video on the C64U" FontWeight="SemiBold"/>
                    <TextBlock Text="Open the C64U menu and press F1 to open the Tools menu. Under Streams, select VIC Stream and choose Start or Send to. Enter the Video address above, including the port, and confirm with Return."
                               TextWrapping="Wrap"/>
                    <TextBlock Text="On older Ultimate 64 firmware, press F5 for the action menu and select Start VIC Stream. The Data Streams configuration screen stores destinations for reuse; it does not start transmission."
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="3. Start audio on the C64U" FontWeight="SemiBold"/>
                    <TextBlock Text="Go back to Tools → Streams and select Audio Stream, then Start or Send to. On older firmware, select Start Audio Stream in the F5 menu. Enter the Audio address above and confirm with Return. Leave the VIC stream running."
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="4. Check picture and sound" FontWeight="SemiBold"/>
                    <TextBlock Text="Cannot find MAC of specified host." FontWeight="SemiBold"/>
                    <TextBlock Text="If the C64U shows this error, disable Wi-Fi on the C64U, check the Ethernet connection and try again. Enter the viewer computer's LAN address as the destination."
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Start a game, demo or SID tune with sound. The viewer’s status bar should read STREAMING ACTIVE (VIDEO + AUDIO). If a stream is missing, check its destination and allow inbound UDP on its configured port in the computer’s firewall. If SDL2 is unavailable, see the viewer’s status-bar warning."
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Content="Close" Click="CloseClick" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" MinWidth="92" HorizontalContentAlignment="Center"/>
    </Grid>
</Window>
