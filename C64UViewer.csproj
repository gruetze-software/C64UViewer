<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ValidateExecutableReferencesRuntimeRequired>false</ValidateExecutableReferencesRuntimeRequired>
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' And !$(RuntimeIdentifier.StartsWith('linux-'))">
    <DisableNativeWayland>true</DisableNativeWayland>
    <DefineConstants>$(DefineConstants);DISABLE_NATIVE_WAYLAND</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.3.3</Version>
    <AssemblyName>c64uviewer</AssemblyName>
    <AssemblyVersion>1.3.3</AssemblyVersion>
    <FileVersion>1.3.3</FileVersion>
    <Authors>Grütze-Software</Authors>
    <Product>C64U Slim-Viewer</Product>
    <PackageIcon>icon.png</PackageIcon>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <Description>Video and audio stream viewer for Commodore 64 Ultimate in .NET 10</Description>
    <Copyright>Copyright © 2026 Grütze-Software</Copyright>
    <Maintainer>schaefer.christoph@posteo.de</Maintainer>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageId>c64uviewer</PackageId>
    <PackageProjectUrl>https://github.com/gruetze-software/C64UViewer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gruetze-software/C64UViewer.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WindowsStoreBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);WINDOWS_STORE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.4" Condition="'$(DisableNativeWayland)' != 'true'" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <AvaloniaResource Include="Assets/icon.ico;Assets/icon.png;Assets/gruetze-software.png" />
    <Content Include="Assets/icon.png">
      <Pack>true</Pack>
      <PackagePath>usr/share/icons/hicolor/256x256/apps/c64uviewer.png</PackagePath>
    </Content>
    <Content Include="c64uviewer.desktop">
      <Pack>true</Pack>
      <PackagePath>usr/share/applications/c64uviewer.desktop</PackagePath>
    </Content>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(NETCoreSdkRuntimeIdentifier)' == 'win-x64')">
    <None Update="Libs/Win64/SDL2.dll" TargetPath="SDL2.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="RemoveReleasePublishSymbols" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb' Or '%(ResolvedFileToPublish.Extension)' == '.dbg'" />
    </ItemGroup>
  </Target>
</Project>
